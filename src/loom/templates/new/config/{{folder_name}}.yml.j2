name: {{agent.name}}
description: {{agent.description}}
version: 0.1.0

{% if agent.model is string %}
model: {{agent.model}}
{% else %}
model:
  import_path: {{agent.model.import_path}}
  params:
{% for key, value in agent.model.params.items() %}
    {{key}}: {{value}}
{% endfor %}
{% endif %}

system_prompt:
  prompt: {{agent.system_prompt.prompt}}

{% if agent.retry is string %}
retry: {{agent.retry}}
{% else %}
retry:
  max_attempts: {{agent.retry.max_attempts}}
  initial_delay: {{agent.retry.initial_delay}}
  max_delay: {{agent.retry.max_delay}}
{% endif %}

{% if agent.output %}
output: {{agent.output}}
{% endif %}

# Optional Strands fields. Leave them commented and the agent is unchanged.
# See docs/guides/memory-context-control.md.
# aux_model: economic
# context: "off"                 # requires conversation: none
# plugins:
#   - goal: { goal: "Answer in one sentence", max_attempts: 2 }
# memory:
#   stores:
#     - file: { name: notes, description: "Facts about {user_id}" }
# interventions:
#   - hitl: { ask: stdio }
# background_tasks: true
# checkpointing: true            # experimental; pair with session in app.yml
# sandbox:                       # overrides app.yml
#   docker: { container: loom-runner }
